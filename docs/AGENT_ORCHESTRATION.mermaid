graph TD
    %% Global Styles & Classes
    classDef orchestrator fill:#FFA500,stroke:#000,stroke-width:3px,color:#000,font-weight:bold
    classDef pro_track fill:#2979FF,stroke:#fff,stroke-width:1px,color:#fff
    classDef fast_track fill:#00E676,stroke:#000,stroke-width:1px,color:#000
    classDef heavy_gate fill:#FF1744,stroke:#fff,stroke-width:2px,color:#fff,font-weight:bold
    classDef infra fill:#121212,stroke:#333,stroke-width:1px,color:#888

    %% Core PM Orchestrator
    PM("fa:fa-user-tie ELITE PM ORCHESTRATOR<br/>(20y Bloomberg Experience)"):::orchestrator

    %% Track A: Infrastructure
    subgraph TrackA ["fa:fa-server TRACK A: INFRA & STATE (PRO)"]
        direction TB
        SM["fa:fa-clock STATE-MACHINE-01<br/>(9-State Lifecycle)"]:::pro_track
        RE["fa:fa-undo RETRY-ENGINE-01<br/>(Exp. Backoff)"]:::pro_track
        RC["fa:fa-database REDIS-CORE-01<br/>(Cache Scaffolding)"]:::pro_track
    end

    %% Track B: Compression
    subgraph TrackB ["fa:fa-compress TRACK B: COMPRESSION (PRO/FAST)"]
        direction TB
        SSO["fa:fa-file-invoice SSO-PIPE-01 (PRO)<br/>(Signal Normalization)"]:::pro_track
        CCB["fa:fa-align-left CCB-PIPE-01 (FAST)<br/>(Context Flattening)"]:::fast_track
        TG["fa:fa-shield-halved TOKEN-GUARD-01 (FAST)<br/>(Hard Cap Enforcement)"]:::fast_track
    end

    %% Track C: NVIDIA
    subgraph TrackC ["fa:fa-brain TRACK C: NVIDIA LAYER (PRO)"]
        direction TB
        NC["fa:fa-plug NVIDIA-CLIENT-01<br/>(Nemotron Nano SDK)"]:::pro_track
        AQ["fa:fa-list-ol AI-QUEUE-01<br/>(Async Worker)"]:::pro_track
        AC["fa:fa-memory AI-CACHE-01<br/>(Read-Through Cache)"]:::pro_track
    end

    %% Track D: UX
    subgraph TrackD ["fa:fa-desktop TRACK D: TERMINAL UX (FAST)"]
        direction TB
        DS["fa:fa-columns DRAWER-STATE-01<br/>(Async Binding)"]:::fast_track
        ASX["fa:fa-terminal AI-STATUS-UX-01<br/>(State Labels)"]:::fast_track
        CX["fa:fa-chart-line CONFIDENCE-UX-01<br/>(Uncertainty UI)"]:::fast_track
    end

    %% Track E: Adversarial QA
    subgraph TrackE ["fa:fa-skull-crossbones TRACK E: ADVERSARIAL QA (HEAVY)"]
        direction TB
        QH["QA-AI-HALLUC-01<br/>(Fabrication Audit)"]:::heavy_gate
        QF["QA-AI-FAIL-01<br/>(Outage Simulation)"]:::heavy_gate
        QL["QA-AI-LATENCY-01<br/>(Stress Testing)"]:::heavy_gate
        QR["QA-AI-REGRESS-01<br/>(Performance Guard)"]:::heavy_gate
    end

    %% Infrastructure Components
    subgraph External ["fa:fa-cloud EXTERNAL INFRA"]
        NV["fa:fa-microchip NVIDIA build.nvidia.com"]:::infra
        RD["fa:fa-bolt Redis Cache"]:::infra
        DB["fa:fa-table PostgreSQL"]:::infra
    end

    %% Workflow & Dependencies
    PM ==> TrackA & TrackB & TrackC & TrackD & TrackE
    
    TrackB -->|"fa:fa-arrow-right 1,500 Chars"| TrackC
    TrackC -->|"fa:fa-arrow-right Narrative"| TrackD
    
    TrackC <--> NV
    TrackA <--> RD
    TrackB <--> DB

    TrackE -.->|"fa:fa-ban HOSTILE AUDIT"| TrackB & TrackC & TrackD
    TrackE -.->|"fa:fa-check-double GATING"| PM

    %% Footer Layout
    Note1["fa:fa-info-circle ZERO-ROOM-FOR-ERROR MANDATE"]
    Note1 --- PM
